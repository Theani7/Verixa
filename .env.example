# Copy to .env and fill in your keys (never commit .env).
# Get a key at https://exa.ai
EXA_API_KEY=
# Get a key at https://console.groq.com
GROQ_API_KEY=
# Postgres connection (local Homebrew database by default)
DATABASE_URL=postgresql+psycopg://verixa:verixa@localhost:5432/verixa
# Signing key for login sessions (generate with: openssl rand -hex 32)
SECRET_KEY=dev-secret-change-me
